# --- Database ---------------------------------------------------------------
# Connessione usata a runtime (su Vercel/Supabase: pooler "transaction", porta 6543).
# Se vuota e non esiste POSTGRES_URL, in sviluppo locale viene usato PGlite su .data/pglite.
DATABASE_URL=
# Connessione diretta/sessione usata dalle migrazioni (porta 5432). Fallback: POSTGRES_URL_NON_POOLING, poi DATABASE_URL.
DIRECT_URL=
# L'integrazione Supabase del Vercel Marketplace crea già queste variabili: vengono lette automaticamente.
# Il database god_game_db usa il prefisso GODGAME_ (GODGAME_POSTGRES_URL, GODGAME_POSTGRES_URL_NON_POOLING).
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# Prefisso delle variabili dell'integrazione (default GODGAME_).
# DATABASE_ENV_PREFIX=GODGAME_
# Numero massimo di connessioni del pool (default 3).
# DATABASE_POOL_MAX=3
# Cartella del database PGlite locale (default .data/pglite). "memory://" per un database effimero.
# PGLITE_DIR=.data/pglite

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mappa di default: "isometric" (predefinita) oppure "debug" (mappa tecnica dall'alto).
# NEXT_PUBLIC_MAP_RENDERER=isometric
# "1" apre di default il pannello prestazioni della mappa.
# NEXT_PUBLIC_MAP_DEBUG=0

# --- Simulazione ------------------------------------------------------------
SIMULATION_MAX_TICKS_PER_REQUEST=100
# Budget di calcolo per singola richiesta: oltre questa soglia il batch si interrompe e salva i tick completati.
SIMULATION_TIME_BUDGET_MS=20000
# Durata massima del lock di simulazione (protezione da lock orfani).
SIMULATION_LOCK_TTL_MS=60000

# --- Cron opzionale -----------------------------------------------------------
# Se impostato, /api/cron/advance avanza i mondi in stato "running" (header Authorization: Bearer <CRON_SECRET>).
# Senza questa variabile la route risponde 401 e il cron resta disattivato: vedi vercel.cron.example.json.
CRON_SECRET=
# Quanti mondi al massimo avanzare per ogni esecuzione del cron (default 3).
# CRON_WORLDS_PER_RUN=3
# Quanti anni simulare per ogni mondo a ogni esecuzione (default 10).
# CRON_TICKS_PER_WORLD=10
# Tempo massimo speso da una singola esecuzione del cron prima di fermarsi (default 45000 ms).
# CRON_BUDGET_MS=45000
